# Copy this file to .env in the repo root. Everything here is optional. Never commit real keys.

# The guide that turns the builder's work into plain words.
# Free key from https://aistudio.google.com/apikey (no credit card). Without it, built-in sentences are used.
GEMINI_API_KEY=
# Leave empty to let Vibeerr pick a Flash model that answers. Set it to force one model id.
GEMINI_MODEL=

# The guide's voice. Free key from https://elevenlabs.io/app/settings/api-keys (needs Text to Speech, and
# Speech to Text if you want ElevenLabs to hear spoken answers). Without it, the browser's own voice is used.
ELEVENLABS_API_KEY=
# Optional: a different voice id from the ElevenLabs voice library. Default: Sarah.
ELEVENLABS_VOICE_ID=

# Where new project folders are suggested. Default: a "Vibeerr" folder in your home folder.
VIBEERR_PROJECTS_DIR=
# Which Claude model the builder uses (for example: sonnet). Default: your Claude Code default.
BUILDSCAPE_CLAUDE_MODEL=
# Port for the app. Default: 4321.
PORT=4321
