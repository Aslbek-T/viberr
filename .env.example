# Copy to .env.local in the repo root. Never commit real keys.
PORT=4321
# Narrator: template (no key needed), haiku, or gemini
NARRATOR=template
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SUPERMEMORY_API_KEY=
XAI_API_KEY=
# ntfy.sh topic for phone pings (pick something hard to guess)
NTFY_TOPIC=
# Set to 1 so hooks never wait for a browser decision
BUILDSCAPE_NO_WAIT=0
